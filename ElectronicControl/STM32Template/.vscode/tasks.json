{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "DAPLink Flash",
            "type": "shell",
            "command": "openocd",
            "args": [
                "-f",
                "interface/cmsis-dap.cfg",
                "-f",
                "target/stm32f1x.cfg",
                "-c",
                "transport select swd",
                "-c",
                "reset_config none",
                "-c",
                "program ./build/Debug/STM32Template.elf verify reset exit"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "ST-LINK Flash",
            "type": "shell",
            "command": "openocd",
            "args": [
                "-f",
                "interface/stlink.cfg",
                "-f",
                "target/stm32f1x.cfg",
                "-c",
                "transport select swd",
                "-c",
                "reset_config none",
                "-c",
                "program ./build/Debug/STM32Template.elf verify reset exit"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
